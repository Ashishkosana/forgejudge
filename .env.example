FORGEJUDGE_SERVICE_NAME=ForgeJudge API
FORGEJUDGE_ENVIRONMENT=local
FORGEJUDGE_LOG_LEVEL=INFO
# Configure authentication keys and a random shared secret before using auth endpoints.
FORGEJUDGE_AUTH_PRIVATE_KEY=
FORGEJUDGE_AUTH_PUBLIC_KEYS=
FORGEJUDGE_AUTH_SIGNING_KEY_ID=local
FORGEJUDGE_BFF_SHARED_SECRET=
POSTGRES_DB=forgejudge
POSTGRES_USER=forgejudge
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgresql+asyncpg://forgejudge:local-development-only@postgres:5432/forgejudge
REDIS_URL=redis://redis:6379/0
FORGEJUDGE_JUDGE_PYTHON_IMAGE=python:3.12-slim
JUDGE_WORKSPACE_VOLUME=forgejudge_judge_workspaces
# On Linux, set this to the group ID that owns /var/run/docker.sock.
DOCKER_GID=0